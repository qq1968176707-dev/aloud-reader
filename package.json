{
  "name": "aloud-reader",
  "productName": "Aloud Reader",
  "version": "0.1.0",
  "private": true,
  "description": "Apple Books-style desktop e-book reader with line-by-line read-aloud (逐行导读)",
  "main": "dist-electron/main.mjs",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "sample": "node scripts/make-sample-book.mjs",
    "smoke:import": "node scripts/smoke.mjs import samples/sample-book.zip",
    "smoke:ui": "node scripts/smoke.mjs ui",
    "dist:win": "npm run build && node scripts/dist.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "fast-xml-parser": "^4.5.0",
    "marked": "^14.1.3",
    "node-html-parser": "^6.1.13",
    "pdfjs-dist": "^4.7.76",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.2",
    "dompurify": "^3.1.7",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "zustand": "^5.0.0"
  }
}
