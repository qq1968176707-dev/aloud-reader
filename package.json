{
  "name": "aloud-reader",
  "productName": "Aloud Reader",
  "version": "0.1.2",
  "private": true,
  "description": "Apple Books-style desktop e-book reader with line-by-line read-aloud (逐行导读)",
  "main": "dist-electron/main.mjs",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "sample": "node scripts/make-sample-book.mjs",
    "icon": "node scripts/make-icon.mjs",
    "smoke:import": "node scripts/smoke.mjs import samples/sample-book.zip",
    "smoke:ui": "node scripts/smoke.mjs ui",
    "dist:win": "node scripts/dist.mjs --win",
    "dist:mac": "node scripts/dist.mjs --mac",
    "dist:win:lite": "node scripts/dist.mjs --win --lite",
    "dist:mac:lite": "node scripts/dist.mjs --mac --lite",
    "build:web": "node scripts/build-web.mjs",
    "dev:web": "vite --config vite.web.config.ts"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "buffer": "^6.0.3",
    "fast-xml-parser": "^4.5.0",
    "fflate": "^0.8.3",
    "marked": "^14.1.3",
    "node-html-parser": "^6.1.13",
    "pdfjs-dist": "^4.7.76",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.2",
    "dompurify": "^3.1.7",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "zustand": "^5.0.0"
  },
  "author": "qq1968176707-dev",
  "license": "SEE LICENSE IN LICENSE"
}
